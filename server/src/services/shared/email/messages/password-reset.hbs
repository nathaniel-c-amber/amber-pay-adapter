{{!--
  password-reset — sent by `POST /auth/forgot-password`.

  That endpoint answers 202 whether or not the address exists, so this message may
  be the only trace of the request — which is why it says plainly that no change
  has happened yet.

  Context: url, expiresIn
--}}
{{#> shell preheader='Choose a new password — the link is single-use and expires.' title='Reset your Amber Pay Ledger password'}}
  {{> eyebrow text='Password reset'}}
  {{> heading text='Reset your password'}}
  {{> paragraph text='Use the button below to choose a new password. The link is single-use, and requesting another one cancels this one.'}}
  {{> button href=url label='Choose a new password'}}
  {{> fallback-link href=url}}
  {{#> facts}}
    {{> facts-row label='Link expires' value=expiresIn}}
    {{> facts-row label='Single use' value='A newer link replaces it'}}
  {{/facts}}
  {{> notice tone='warn' label='Did not request this?' text='No action is needed — your password has not changed, and the link cannot be used once it expires.'}}
{{/shell}}
