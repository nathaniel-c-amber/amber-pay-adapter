{{!--
  eyebrow — a short uppercase mono label naming what the message is.

    {{> eyebrow text='Invitation'}}

  `text` (required).
--}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"{{styleAttr 'eyebrow.table'}}>
  <tr><td{{styleAttr 'eyebrow.cell'}}>{{text}}</td></tr>
</table>
