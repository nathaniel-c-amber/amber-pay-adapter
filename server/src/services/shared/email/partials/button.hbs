{{!--
  button — the primary action.

    {{> button href=url label='Set up your account'}}

  `href`, `label` (required).

  A table wraps the anchor so the amber block still paints in clients that ignore
  padding on an inline element; `bgcolor` is the belt to the inline style's braces,
  because Outlook honours the attribute before CSS. The label is `onPrimary`, never
  white — white on the brand amber measures 3.31:1 and fails AA.
--}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"{{styleAttr 'button.table'}}>
  <tr><td align="left">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr><td bgcolor="{{token 'color.primary'}}"{{styleAttr 'button.box'}}>
        <a href="{{href}}"{{styleAttr 'button.anchor'}}>{{label}}</a>
      </td></tr>
    </table>
  </td></tr>
</table>
