# ------------------------------------------------------------------
# Amber Pay API Adaptor & Monitor System - backend environment
# Copy to `.env` and fill in real values. NEVER commit real secrets.
#
# DOCKER-COMPOSE USAGE
# --------------------
# The full stack is run from the repo root with `docker compose up --build`.
# docker-compose reads a root `.env` file (see the root `.env.example` /
# README) and injects the required vars into the `api` service. When running
# the backend standalone (outside Docker), copy THIS file to `server/.env`
# and set the values below.
#
# REQUIRED (the app fails fast if missing):
#   NODE_ENV, DATABASE_URL, JWT_SECRET, AMBER_PAY_WEBHOOK_SECRET
# OPTIONAL: PORT (default 3000), LOG_LEVEL, CORS_ORIGINS, JWT_TTL,
#   INVITE_TTL, TWO_FACTOR_TTL, AMBER_PAY_*, QUICKBOOKS_*, SAGE_*,
#   SMTP_*, APP_BASE_URL
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/amber_pay

# Auth (JWT + PBAC)
JWT_SECRET=change-me-replace-with-a-long-random-secret
JWT_TTL=1h
INVITE_TTL=48h
TWO_FACTOR_TTL=5m

# Super admin bootstrap (OPTIONAL). Setting BOTH seeds a super admin (all
# privileges, all scopes/orgs) on install. Idempotent: an existing user is
# never overwritten. Leave unset to skip seeding.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Amber Pay
AMBER_PAY_BASE_URL=https://api.amberpay.example.com
AMBER_PAY_WEBHOOK_SECRET=change-me-replace-with-webhook-secret

# QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com
QUICKBOOKS_REALM_ID=

# Sage
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_BASE_URL=https://api.sage.com

# Email (SMTP). When SMTP_HOST is set, invites and 2FA codes are delivered via
# SMTP; otherwise delivery is stubbed (logged, never the body/code/token).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURE=starttls
# Base URL used to build the invite link in emails.
APP_BASE_URL=http://localhost:5173
