# ------------------------------------------------------------------
# Amber Pay Ledger - backend environment
# Copy to `.env` and fill in real values. NEVER commit real secrets.
#
# DOCKER-COMPOSE USAGE
# --------------------
# The full stack is run from the repo root with `docker compose up --build`.
# docker-compose reads a root `.env` file (see the root `.env.example` /
# README) and injects the required vars into the `api` service. When running
# the backend standalone (outside Docker), copy THIS file to `server/.env`
# and set the values below.
#
# REQUIRED (the app fails fast if missing):
#   NODE_ENV, DATABASE_URL, JWT_SECRET, AMBER_PAY_WEBHOOK_SECRET
# OPTIONAL: PORT (default 3300), LOG_LEVEL, LOG_TO_FILE, LOG_DIR,
#   LOG_FILE_NAME, LOG_MAX_SIZE_BYTES, LOG_MAX_FILES, CORS_ORIGINS, JWT_TTL,
#   INVITE_TTL, TWO_FACTOR_TTL, TRUSTED_PROXY_HOPS, ORGANIZATION_ID, ADAPTOR_ID,
#   SECRETS_KEY, SECRETS_KEY_VERSION, SECRETS_KEY_PREVIOUS,
#   QUICKBOOKS_ENVIRONMENT, QUICKBOOKS_REDIRECT_URI,
#   AMBER_PAY_*, QUICKBOOKS_*, SAGE_*, SMTP_*, APP_BASE_URL
# ------------------------------------------------------------------

# Server
PORT=3300
NODE_ENV=development
LOG_LEVEL=info

# Logging. `LOG_LEVEL` applies to every sink. The process always writes to
# stdout; these control the ADDITIONAL rotating file sink, which is what makes
# the log survive a container restart. Off in tests, always.
# Log file: <LOG_DIR>/<LOG_FILE_NAME>, rotated to `.1`, `.2`, ... `.N`
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=server.log
# 5 MiB per file, 5 files retained (~25 MiB ceiling per instance).
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Reverse proxies in front of this process. Leave at 1 behind nginx; 0 when
# the API is reached directly (no proxy). This decides what `req.ip` means, so
# the rate limiters key on the real client rather than on the proxy.
TRUSTED_PROXY_HOPS=1

# The ONE organization this deployment serves (one deployment per organization).
# Every stored row and every generated policy attribute must agree on this value —
# a mismatch makes rows invisible to the users they are about, with no error.
ORGANIZATION_ID=default

# The ONE accounting system this deployment integrates with: quickbooks | sage.
# The other stays in the image but is never probed, listed or pushed to — without
# this, a QuickBooks-only deployment shows a suspended Sage route it cannot fix.
# The onboarding wizard takes ownership of this once it has run.
ADAPTOR_ID=quickbooks

# Credential encryption. Required once the onboarding wizard stores a gateway or
# accounting credential; generate one per deployment with `openssl rand -hex 32`.
# Left blank the API still starts, it simply cannot store credentials.
SECRETS_KEY=
# To rotate: move the current key down to SECRETS_KEY_PREVIOUS, put the new key in
# SECRETS_KEY, and raise this. The previous key stays readable, so nothing is lost.
SECRETS_KEY_VERSION=1
SECRETS_KEY_PREVIOUS=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/amber_pay

# Auth (JWT + PBAC)
JWT_SECRET=change-me-replace-with-a-long-random-secret
JWT_TTL=1h
INVITE_TTL=48h
TWO_FACTOR_TTL=5m

# Super admin bootstrap (OPTIONAL). Setting BOTH seeds a super admin (all
# privileges, all scopes/orgs) on install. Idempotent: an existing user is
# never overwritten. Leave unset to skip seeding.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Amber Pay
AMBER_PAY_BASE_URL=https://api.amberpay.example.com
AMBER_PAY_WEBHOOK_SECRET=change-me-replace-with-webhook-secret

# QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com
QUICKBOOKS_REALM_ID=
# A bearer token authorizes calls; client id/secret alone cannot mint one.
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REFRESH_TOKEN=

# QuickBooks browser authorization. The setup wizard sends an operator to Intuit
# to sign in and consent, which is the ONLY way to obtain a grant — a client id
# and secret identify the application, they cannot authorize anything by
# themselves. The wizard keeps the resulting refresh token and rotates it from
# then on, so nobody has to paste a token.
#
# sandbox | production. The two are separate tenants with separate apps and
# separate companies, so the environment must be named rather than guessed.
QUICKBOOKS_ENVIRONMENT=production
# Where Intuit sends the browser back after consent. Defaults to
# ${APP_BASE_URL}/api/v1/settings/adaptor/callback.
#
# IT MUST BE REGISTERED with your Intuit app, and Intuit requires https except
# for localhost (permitted in the sandbox). An unregistered redirect URI is the
# single most likely reason a connect attempt appears to fail with no error
# anywhere in the console.

# Sage
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_BASE_URL=https://api.sage.com

# Email (SMTP). When SMTP_HOST is set, invites and 2FA codes are delivered via
# SMTP; otherwise delivery is stubbed (logged, never the body/code/token).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURE=starttls
# Base URL used to build the invite link in emails.
APP_BASE_URL=http://localhost:5173
