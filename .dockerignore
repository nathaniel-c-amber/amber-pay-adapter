# Build context exclusions (root). Used by the `api` Docker build
# (docker-compose `api` service: context `.` + dockerfile `server/Dockerfile`).
# The frontend lives in `web/` and is excluded so the api image stays lean.

# Frontend (separate build context under web/)
web

# Dependencies
node_modules
server/node_modules

# Build output
dist
server/dist

# VCS / tooling
.git
.slim
.impeccable
.opencode

# Local / secrets
*.local
.env
.env.*
!.env.example

# Misc
coverage
*.tsbuildinfo
*.log
.DS_Store