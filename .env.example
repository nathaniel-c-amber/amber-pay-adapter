# ------------------------------------------------------------------
# Amber Pay Ledger — docker-compose environment
# Copy to `.env` in the repo root and fill in real values.
# docker-compose reads this file automatically. NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL (used by the `db` service and the `api` DATABASE_URL)
POSTGRES_USER=amber
POSTGRES_PASSWORD=amber
POSTGRES_DB=amber

# Backend
# Runtime mode of the `api` service. Under `development` the API returns the
# 2FA code (and invite/reset tokens) in its responses so sign-in can be
# completed without a mailbox — the console auto-fills the code. Defaults to
# `production` when unset; those values are credentials, so never run
# development anywhere others can reach it.
NODE_ENV=production
# JWT_SECRET must be >= 16 characters.
JWT_SECRET=change-me-jwt-secret-0123456789abcdef
# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:8080

# Optional backend tuning
LOG_LEVEL=info
# Rotating file log inside the `api` container, kept on the `api-logs` volume
# (/app/logs). `false` leaves stdout as the only sink.
LOG_TO_FILE=true
# 5 MiB per file, 5 files retained.
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5
JWT_TTL=1h
INVITE_TTL=48h
TWO_FACTOR_TTL=5m
# Reverse proxies in front of the API: 1 for nginx alone, 2 when the ngrok
# tunnel profile is also active, 0 when the API is exposed directly.
# Too low breaks per-IP rate limiting; too high lets a client forge
# X-Forwarded-For and escape it. See server/.env.example.
TRUSTED_PROXY_HOPS=1

# The ONE organization this deployment serves (one deployment per organization).
# Every stored row and every generated policy attribute must agree on this value.
# When they disagree the symptom is an empty console rather than an error.
ORGANIZATION_ID=default

# The ONE accounting system this deployment integrates with: quickbooks | sage.
# The other stays in the image but is never probed, listed or pushed to — without
# this, a QuickBooks-only deployment shows a suspended Sage route it cannot fix.
# The onboarding wizard takes ownership of this once it has run.
ADAPTOR_ID=quickbooks

# Credential encryption — required once the onboarding wizard stores a gateway or
# accounting credential. Generate one per deployment: openssl rand -hex 32
# Blank is accepted (the API still starts, it just cannot store credentials).
SECRETS_KEY=
# To rotate: move the current key down to SECRETS_KEY_PREVIOUS, put the new key
# in SECRETS_KEY, and raise this. The previous key stays readable, nothing is lost.
SECRETS_KEY_VERSION=1
SECRETS_KEY_PREVIOUS=

# Super admin bootstrap (optional). Setting BOTH seeds a super admin (all
# privileges, all scopes/orgs) on install. Idempotent: an existing user is
# never overwritten. Leave unset to skip seeding.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Amber Pay gateway
AMBER_PAY_BASE_URL=https://api.amberpay.example.com
AMBER_PAY_WEBHOOK_SECRET=change-me-webhook-secret

# The merchant account the gateway issued for THIS project and environment.
# It goes into every signature request, so a checkout cannot be created without
# it. Amber issues a SEPARATE id for dev and prod, and a signature made with the
# wrong one is refused by the other environment with no message saying which
# value was at fault — so keep them apart per deployment.
AMBER_PAY_CLIENT_ID=change-me-merchant-client-id

# Bearer token authenticating the requests WE make to the gateway
# (`generatesignature`, and later `transactionstatus` / `refund`). It is sent as
# `Authorization: Bearer …`.
#
# It is NEVER sent to the browser. The checkout form is posted to the gateway by
# the customer's own browser, so a token in that form would be a live credential
# in the DOM, in a screenshot and in every support log since. The Signature field
# proves the checkout; this proves us.
AMBER_PAY_API_TOKEN=change-me-gateway-bearer-token

# The origin the browser is allowed to POST the card form to. It is a bare
# origin (scheme and host, NO PATH) because that is what the CSP's `form-action`
# takes, and it is read by the WEB container, which renders it into the security
# headers at start-up. A path here renders a directive that looks configured and
# silently blocks every checkout.
AMBER_PAY_CHECKOUT_ORIGIN=https://staging-payment.myamberpay.com

# The gateway has no real upstream yet, so POST /payments returns 502 by
# default. Set this to true (outside production only) to fabricate payment
# links locally so that endpoint can be exercised end to end. It takes an
# explicit opt-in because the `tunnel` profile publishes this stack publicly
# and a non-production NODE_ENV is normal there. Leave unset/false anywhere
# reachable by anyone you do not control.
AMBER_PAY_DEV_TRANSPORT=false

# QuickBooks (optional)
# Client id/secret identify the app; a bearer token authorizes calls. Provide an
# access token directly (valid ~1h), or a refresh token for the API to exchange
# and keep refreshed. Without one of the two the adaptor reports
# "configured but not authorized" rather than connecting.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Sage (optional)
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_BASE_URL=https://api.sage.com

# Email (SMTP, optional). When SMTP_HOST is set, invites and 2FA codes are
# delivered via SMTP; otherwise delivery is stubbed (logged, never the body).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURE=starttls
# Base URL used to build the invite link in emails.
APP_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------
# ngrok tunnel (optional, for testing across the internet)
# Start with: docker compose --profile tunnel up --build
# ------------------------------------------------------------------
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# Required for reserved/static domains and higher rate limits. Optional for
# ephemeral URLs, but strongly recommended.
NGROK_AUTHTOKEN=
# Reserved/static domain (e.g. amber-pay-demo.ngrok-free.app). Leave unset to
# get a random ephemeral URL on each start.
NGROK_DOMAIN=